# Supabase (Project Settings -> API). Service-role key is SERVER ONLY. Never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared code players must enter on the profile form (share it in GroupMe, not on the page).
TEAM_CODE=

# Passcode for the coach dashboard, and a long random string used to sign its session cookie.
COACH_PASSCODE=

# Optional: a second passcode for assistant coaches (roster + profiles + schedule, no contact info or admin).
ASSISTANT_PASSCODE=
SESSION_SECRET=

# GroupMe bot (dev.groupme.com -> Bots). Posting only. Scripts preview first and need --send.
GROUPME_BOT_ID=

# LOCAL ONLY, for `npm run migrate`. Supabase -> Connect -> Session pooler URI (includes the DB password).
# Never add this to Vercel or commit it.
SUPABASE_DB_URL=
